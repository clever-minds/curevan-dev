# Curevan frontend environment. Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_API_URL=                      # backend base URL, e.g. https://api.curevan.com
NEXT_PUBLIC_SITE_URL=                     # this website's public address, e.g. https://www.curevan.com (sitemap, canonical links)
NEXT_PUBLIC_TRACKING_URL_BASE=            # optional: courier tracking page, default https://shiprocket.co/tracking
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=          # Google Maps/Places key (restrict by HTTP referrer)
NEXT_PUBLIC_RAZORPAY_KEY_ID=              # Razorpay public key id (test key in development)
NEXT_PUBLIC_GA_ID=                        # Google Analytics id (optional)
NEXT_PUBLIC_FIREBASE_API_KEY=             # Firebase web config (phone OTP + push)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=        # true only for local emulator use
JWT_SECRET=                               # must equal the backend JWT_SECRET (server-side token check)
AI_FEATURES_ENABLED=                      # true to load Genkit flows in dev
GEMINI_API_KEY=                           # Gemini key for Genkit (server-side only)
AI_MODEL_ID=                              # the Gemini model id the assistant and the notes/refine flows use (the current Gemini Flash id from Google AI docs). Required: empty = assistant says it is unavailable. Change it here only, no code change. Check it on Admin > AI Settings > Model health check.
